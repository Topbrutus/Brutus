{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brutus.local/contracts/prototype-manifest.v0.schema.json",
  "title": "Brutus Prototype Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA",
    "PROTOTYPE_ID",
    "VERSION",
    "ANCHOR_ID",
    "TITLE",
    "PURPOSE",
    "STATUS",
    "CARD_IDS",
    "PARAMETERS",
    "EXPECTED_OUTPUTS",
    "PROOF_REFS",
    "NOTES"
  ],
  "properties": {
    "SCHEMA": {
      "const": "BRUTUS-PROTOTYPE-MANIFEST-v0.1"
    },
    "PROTOTYPE_ID": {
      "type": "string",
      "pattern": "^BRUTUS-PROTOTYPE-[A-Z0-9-]+$"
    },
    "VERSION": {
      "const": "0.1"
    },
    "ANCHOR_ID": {
      "const": "ANCHOR-0001"
    },
    "TITLE": {
      "type": "string",
      "minLength": 1
    },
    "PURPOSE": {
      "type": "string",
      "minLength": 1
    },
    "STATUS": {
      "enum": ["DRAFT", "ACTIVE", "PAUSED", "CLOSED"]
    },
    "CARD_IDS": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "PARAMETERS": {
      "type": "object"
    },
    "EXPECTED_OUTPUTS": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "PROOF_REFS": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "NOTES": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-brutus-status": "ANCHOR_WORKSPACE_CONTRACT",
  "x-security": "Data-only manifest. No executable code or credential field."
}
