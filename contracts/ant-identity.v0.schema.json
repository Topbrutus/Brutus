{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brutus.local/contracts/ant-identity.v0.schema.json",
  "title": "Brutus Ant Identity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA",
    "SOURCE_SCHEMA",
    "ANT_ID",
    "ROLE",
    "STATE",
    "FORM",
    "MEMORY_ID",
    "LINEAGE",
    "BIRTH_WALLCLOCK_MS",
    "LIFE_CLOCK_ASSIGNED",
    "BECOME_SYNAPSE_DONE",
    "ROUTING_AUTHORIZATION"
  ],
  "properties": {
    "SCHEMA": {
      "const": "BRUTUS-ANT-IDENTITY-v0.1"
    },
    "SOURCE_SCHEMA": {
      "const": "ANTMUX-ANT-BIRTH-v1"
    },
    "ANT_ID": {
      "type": "string",
      "pattern": "^ANT-[0-9A-F]{12}$"
    },
    "ROLE": {
      "const": "SYNAPSE"
    },
    "STATE": {
      "type": "string",
      "minLength": 1
    },
    "FORM": {
      "type": "string",
      "minLength": 1
    },
    "MEMORY_ID": {
      "type": "string",
      "minLength": 1
    },
    "LINEAGE": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "BIRTH_WALLCLOCK_MS": {
      "type": "integer",
      "minimum": 0
    },
    "LIFE_CLOCK_ASSIGNED": {
      "const": true
    },
    "BECOME_SYNAPSE_DONE": {
      "const": true
    },
    "ROUTING_AUTHORIZATION": {
      "const": "UNDECIDED"
    }
  },
  "x-brutus-status": "AUDITED_CANDIDATE",
  "x-time-boundary": "BIRTH_WALLCLOCK_MS comes from time.time(); World Router TICK must come from QueenCore."
}
