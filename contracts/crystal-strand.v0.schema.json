{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brutus.local/contracts/crystal-strand.v0.schema.json",
  "title": "Brutus Crystal Strand v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA",
    "VERSION",
    "STRAND_ID",
    "CLOCK_AUTHORITY",
    "TICK_START",
    "TICK_END",
    "REPLAY_COUNT",
    "PARENT_CRYSTAL_REFS",
    "BEADS",
    "SIGNATURE_METHOD",
    "SIGNATURE_H256",
    "PROOF_REF",
    "EXECUTABLE",
    "MUTATION_AUTHORITY",
    "DUST_CREATION_AUTHORITY",
    "DELETION_AUTHORITY"
  ],
  "properties": {
    "SCHEMA": { "const": "BRUTUS-CRYSTAL-STRAND-v0.1" },
    "VERSION": { "const": "0.1" },
    "STRAND_ID": {
      "type": "string",
      "pattern": "^STRAND-[A-Z0-9-]{4,80}$"
    },
    "CLOCK_AUTHORITY": { "const": "QUEEN_SERVER_V0_2" },
    "TICK_START": { "type": "integer", "minimum": 0 },
    "TICK_END": { "type": "integer", "minimum": 0 },
    "REPLAY_COUNT": { "type": "integer", "minimum": 0 },
    "PARENT_CRYSTAL_REFS": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BRUTUS-CRYSTAL-[A-Z0-9-]+$"
      }
    },
    "BEADS": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["BEAD_ID", "TICK", "MODALITIES", "INTERNAL"],
        "properties": {
          "BEAD_ID": {
            "type": "string",
            "pattern": "^B-T[0-9]{1,16}-[A-Z0-9-]{2,64}$"
          },
          "TICK": { "type": "integer", "minimum": 0 },
          "MODALITIES": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "KIND",
                "SOURCE_REF",
                "SOURCE_H256",
                "FEATURE_H256",
                "SALIENCE",
                "CONFIDENCE"
              ],
              "properties": {
                "KIND": {
                  "enum": ["AUDITION", "VISION", "TOUCH", "ODOR", "TASTE", "INTERNAL"]
                },
                "SOURCE_REF": { "type": "string", "minLength": 1, "maxLength": 256 },
                "SOURCE_H256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "FEATURE_H256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "SALIENCE": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "CONFIDENCE": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "INTERNAL": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "LOGICAL_HZ",
              "VALENCE",
              "LEFT_PHASE_DEG",
              "RIGHT_PHASE_DEG"
            ],
            "properties": {
              "LOGICAL_HZ": {
                "type": "number",
                "minimum": 0,
                "maximum": 20000
              },
              "VALENCE": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "LEFT_PHASE_DEG": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "RIGHT_PHASE_DEG": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              }
            }
          }
        }
      }
    },
    "SIGNATURE_METHOD": {
      "const": "BRUTUS-CANONICAL-JSON-SHA256-v0.1"
    },
    "SIGNATURE_H256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "PROOF_REF": { "type": "null" },
    "EXECUTABLE": { "const": false },
    "MUTATION_AUTHORITY": { "const": false },
    "DUST_CREATION_AUTHORITY": { "const": false },
    "DELETION_AUTHORITY": { "const": false }
  },
  "x-brutus-status": "CANDIDATE_CRYSTAL_STRAND_CONTRACT",
  "x-security": "Immutable data-only strand. Metabolism result is advisory and cannot mutate, delete, create dust, create crystal, claim proof or authorize routing."
}
