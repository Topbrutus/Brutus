{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://brutus.local/contracts/live-fourmi-transport-authorization.v0.schema.json",
  "title":"Brutus Live Fourmi Transport Authorization v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "SCHEMA","VERSION","AUTHORIZATION_ID","ANT_ID","ANT_IDENTITY_H256",
    "MATERIAL_ID","MATERIAL_H256","ISSUED_AT_TICK","VALID_FROM_TICK",
    "EXPIRES_AT_TICK","CLOCK_AUTHORITY","SCOPE","AUTHORIZATION","TRACE_ID",
    "PROOF_REF","SINGLE_USE","EXECUTABLE","GATE_AUTHORITY",
    "ROUTING_AUTHORIZATION","SIGNATURE_METHOD","SIGNATURE_H256"
  ],
  "properties":{
    "SCHEMA":{"const":"BRUTUS-LIVE-FOURMI-TRANSPORT-AUTHORIZATION-v0.1"},
    "VERSION":{"const":"0.1"},
    "AUTHORIZATION_ID":{
      "type":"string",
      "pattern":"^LTA-T[0-9]{1,16}-[A-F0-9]{20}$"
    },
    "ANT_ID":{"type":"string","pattern":"^ANT-[0-9A-F]{12}$"},
    "ANT_IDENTITY_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "MATERIAL_ID":{"type":"string","pattern":"^MAT-MATH-[A-F0-9]{24}$"},
    "MATERIAL_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "ISSUED_AT_TICK":{"type":"integer","minimum":0},
    "VALID_FROM_TICK":{"type":"integer","minimum":0},
    "EXPIRES_AT_TICK":{"type":"integer","minimum":0},
    "CLOCK_AUTHORITY":{"const":"QUEEN_SERVER_V0_2"},
    "SCOPE":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "PURPOSE","FROM","TO","MATERIAL_CLASS","REQUIRED_ANT_ROLE",
        "REQUIRED_ANT_STATE","MAX_MOVES"
      ],
      "properties":{
        "PURPOSE":{"const":"MATERIAL_TRANSPORT"},
        "FROM":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "TO":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "MATERIAL_CLASS":{"const":"FOURMI_MATH_MATERIAL"},
        "REQUIRED_ANT_ROLE":{"const":"SYNAPSE"},
        "REQUIRED_ANT_STATE":{"type":"string","minLength":1,"maxLength":80},
        "MAX_MOVES":{"const":1}
      }
    },
    "AUTHORIZATION":{
      "type":"object",
      "additionalProperties":false,
      "required":["POLICY","DECISION","APPROVER"],
      "properties":{
        "POLICY":{"const":"BRUTUS-LIVE-FOURMI-TRANSPORT-v0.1"},
        "DECISION":{"const":"APPROVED"},
        "APPROVER":{"const":"BRUTUS_CONTROL_PLANE"}
      }
    },
    "TRACE_ID":{"type":"string","pattern":"^TRACE-[A-Z0-9-]{4,64}$"},
    "PROOF_REF":{"type":"null"},
    "SINGLE_USE":{"const":true},
    "EXECUTABLE":{"const":false},
    "GATE_AUTHORITY":{"const":false},
    "ROUTING_AUTHORIZATION":{"const":"AUTHORIZED"},
    "SIGNATURE_METHOD":{"const":"BRUTUS-CANONICAL-JSON-SHA256-v0.1"},
    "SIGNATURE_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
  },
  "x-security":"Single-use live transport grant bound to one validated ANT identity, one exact Fourmi math material, one exact world edge and a finite Queen-tick validity window. Authorization does not itself move anything or create proof."
}