{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://brutus.local/contracts/fourmi-math-material-move.v0.schema.json",
  "title":"Brutus Fourmi Math Material Move v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "SCHEMA","VERSION","MOVE_ID","EVENT_TYPE","TICK","CLOCK_AUTHORITY",
    "MATERIAL_REF","CARRIER","ANT_MOVE_REF","MOVEMENT","BRUTUS_TRUTH_STATUS",
    "PROOF_REF","PROOF_CREATED","PROOF_CLAIM","MATERIAL_MUTATED",
    "PARENT_CRYSTAL_MUTATED","TRANSPORT_AUTHORIZATION",
    "WHEEL_INGRESS_AUTHORIZATION","MACHINE_EXECUTION_AUTHORIZATION",
    "ROUTING_AUTHORIZATION","EXECUTABLE","GATE_AUTHORITY",
    "SIGNATURE_METHOD","MOVE_H256"
  ],
  "properties":{
    "SCHEMA":{"const":"BRUTUS-FOURMI-MATH-MATERIAL-MOVE-v0.1"},
    "VERSION":{"const":"0.1"},
    "MOVE_ID":{"type":"string","pattern":"^MMOVE-T[0-9]{1,16}-[A-F0-9]{20}$"},
    "EVENT_TYPE":{"const":"MATERIAL_MOVE"},
    "TICK":{"type":"integer","minimum":0},
    "CLOCK_AUTHORITY":{"const":"QUEEN_SERVER_V0_2"},
    "MATERIAL_REF":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "MATERIAL_ID","MATERIAL_H256","PARENT_CRYSTAL_ID",
        "PARENT_CRYSTAL_H256","CONTENT_H256","EXPRESSION_H256"
      ],
      "properties":{
        "MATERIAL_ID":{"type":"string","pattern":"^MAT-MATH-[A-F0-9]{24}$"},
        "MATERIAL_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "PARENT_CRYSTAL_ID":{"type":"string","pattern":"^MATH-CRYSTAL-[A-F0-9]{24}$"},
        "PARENT_CRYSTAL_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "CONTENT_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "EXPRESSION_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
      }
    },
    "CARRIER":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "ANT_ID","ANT_IDENTITY_H256","CARRIER_OBSERVATION_ID",
        "CARRIER_OBSERVATION_H256","RUNTIME_VERIFIED"
      ],
      "properties":{
        "ANT_ID":{"type":"string","pattern":"^ANT-[0-9A-F]{12}$"},
        "ANT_IDENTITY_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "CARRIER_OBSERVATION_ID":{"type":"string","pattern":"^MMCO-T[0-9]{1,16}-[A-Z0-9-]{4,64}$"},
        "CARRIER_OBSERVATION_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "RUNTIME_VERIFIED":{"const":true}
      }
    },
    "ANT_MOVE_REF":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "EVENT_ID","EVENT_SIGNATURE_H256","TRACE_ID","FROM","TO",
        "SOURCE_OBSERVATION_ID","SOURCE_SCHEMA","SOURCE_ENDPOINT"
      ],
      "properties":{
        "EVENT_ID":{"type":"string","pattern":"^RME-T[0-9]{1,16}-[A-Z0-9-]{4,64}$"},
        "EVENT_SIGNATURE_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "TRACE_ID":{"type":"string","pattern":"^TRACE-[A-Z0-9-]{4,64}$"},
        "FROM":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "TO":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "SOURCE_OBSERVATION_ID":{"type":"string","minLength":4,"maxLength":256},
        "SOURCE_SCHEMA":{"type":"string","minLength":3,"maxLength":160},
        "SOURCE_ENDPOINT":{"type":"string","minLength":1,"maxLength":256}
      }
    },
    "MOVEMENT":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "FROM","TO","MATERIAL_STATE_BEFORE","MATERIAL_STATE_AFTER",
        "ANT_MOVED","MATERIAL_BOUND_AT_MOVE","MATERIAL_MOVEMENT_VERIFIED"
      ],
      "properties":{
        "FROM":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "TO":{"type":"string","pattern":"^W:[A-Z0-9-]{1,32}$"},
        "MATERIAL_STATE_BEFORE":{"const":"ADMITTED_NOT_MOVED"},
        "MATERIAL_STATE_AFTER":{"const":"MOVED_OBSERVED"},
        "ANT_MOVED":{"const":true},
        "MATERIAL_BOUND_AT_MOVE":{"const":true},
        "MATERIAL_MOVEMENT_VERIFIED":{"const":true}
      }
    },
    "BRUTUS_TRUTH_STATUS":{"const":"UNVERIFIED_BY_BRUTUS"},
    "PROOF_REF":{"type":"null"},
    "PROOF_CREATED":{"const":false},
    "PROOF_CLAIM":{"const":false},
    "MATERIAL_MUTATED":{"const":false},
    "PARENT_CRYSTAL_MUTATED":{"const":false},
    "TRANSPORT_AUTHORIZATION":{"const":true},
    "WHEEL_INGRESS_AUTHORIZATION":{"const":false},
    "MACHINE_EXECUTION_AUTHORIZATION":{"const":false},
    "ROUTING_AUTHORIZATION":{"const":"UNDECIDED"},
    "EXECUTABLE":{"const":false},
    "GATE_AUTHORITY":{"const":false},
    "SIGNATURE_METHOD":{"const":"BRUTUS-CANONICAL-JSON-SHA256-v0.1"},
    "MOVE_H256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
  },
  "x-security":"Movement receipt requires validated material, live ant identity, explicit attached carrier observation, and validated ANT_MOVE. No wheel ingress, routing, execution or proof promotion."
}