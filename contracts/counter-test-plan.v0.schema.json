{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brutus.local/contracts/counter-test-plan.v0.schema.json",
  "title": "Brutus Counter-Test Plan v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA",
    "PLAN_ID",
    "VERSION",
    "ANCHOR_ID",
    "PROTOTYPE_ID",
    "SOURCE_RECORD_IDS",
    "TITLE",
    "QUESTION",
    "PRIORITY",
    "STATUS",
    "CHECKS",
    "CONFIRMATION_CRITERIA",
    "CONTRADICTION_CRITERIA",
    "OUTPUT_RECORD_TYPE",
    "AUTO_EXECUTE",
    "PROOF_PROMOTION",
    "NOTES"
  ],
  "properties": {
    "SCHEMA": {
      "const": "BRUTUS-COUNTER-TEST-PLAN-v0.1"
    },
    "PLAN_ID": {
      "type": "string",
      "pattern": "^BRUTUS-COUNTER-TEST-[A-Z0-9-]+$"
    },
    "VERSION": {
      "const": "0.1"
    },
    "ANCHOR_ID": {
      "const": "ANCHOR-0001"
    },
    "PROTOTYPE_ID": {
      "const": "BRUTUS-PROTOTYPE-COUNTER-TEST-BENCH-0001"
    },
    "SOURCE_RECORD_IDS": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BRUTUS-RECORD-[A-Z0-9-]+$"
      }
    },
    "TITLE": {
      "type": "string",
      "minLength": 1
    },
    "QUESTION": {
      "type": "string",
      "minLength": 1
    },
    "PRIORITY": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "STATUS": {
      "enum": ["READY", "BLOCKED"]
    },
    "CHECKS": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "CHECK_ID",
          "KIND",
          "DESCRIPTION"
        ],
        "properties": {
          "CHECK_ID": {
            "type": "string",
            "pattern": "^CT-[0-9]{2}$"
          },
          "KIND": {
            "enum": [
              "EXACT_ARITHMETIC",
              "MACHINE_REPRODUCTION",
              "SOURCE_AUDIT",
              "BOUNDED_SCAN",
              "FACTORIZATION",
              "RANK_VERIFICATION",
              "INVARIANT"
            ]
          },
          "DESCRIPTION": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CONFIRMATION_CRITERIA": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "CONTRADICTION_CRITERIA": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "OUTPUT_RECORD_TYPE": {
      "const": "RESULT"
    },
    "AUTO_EXECUTE": {
      "const": false
    },
    "PROOF_PROMOTION": {
      "const": "MANUAL_AFTER_VERIFICATION"
    },
    "NOTES": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "x-brutus-status": "COUNTER_TEST_PLAN_ONLY",
  "x-security": "Data-only immutable plan. No executable code, credentials, automatic proof promotion or route invocation."
}
